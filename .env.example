# Copie para .env e ajuste se precisar (o sistema funciona sem nada disso no computador).
PORT=3000
# Pasta onde ficam o banco de dados e as cópias de segurança. Em hospedagem, aponte para um DISCO PERSISTENTE.
DATA_DIR=./data
# Fuso usado para "hoje" e "vencidas"
APP_TZ=America/Sao_Paulo
# Quando o sistema fica atrás de um serviço com HTTPS (Render, Railway, Fly, Nginx...):
TRUST_PROXY=1
COOKIE_SECURE=1
